# ---- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://ckw-journey-engine.vercel.app
NEXT_PUBLIC_SHOP_ADDRESS=Maple Grove, MN
NEXT_PUBLIC_SHOP_PHONE_DISPLAY=

# ---- Supabase (Project Settings → API) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose

# ---- Scheduled sender (Vercel sends this as a Bearer token) ------------
CRON_SECRET=

# ---- Texts: Quo ---------------------------------------------------------
QUO_API_KEY=
QUO_FROM_NUMBER=                    # E.164, e.g. +16125550100

# ---- Email: Resend ------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Chef KnifeWorks <hello@chefknifeworks.com>
RESEND_REPLY_TO=

# ---- Payments: Square ---------------------------------------------------
SQUARE_ENV=sandbox                  # sandbox | production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2025-01-23
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://YOUR_DOMAIN/api/webhooks/square

# ---- Journey tuning (all optional) -------------------------------------
GOOGLE_REVIEW_URL=                  # your Google Business "write a review" link
REFERRAL_REWARD_TEXT=$10 off
RESHARPEN_AFTER_DAYS=90
REVIEW_AFTER_DAYS=2
REFERRAL_INVITE_AFTER_DAYS=7
REVIEW_COOLDOWN_DAYS=365
PICKUP_NUDGE_AFTER_HOURS=48
BOOKING_HORIZON_DAYS=21
BOOKING_MIN_LEAD_MINUTES=30
